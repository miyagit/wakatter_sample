!!!
%html
  %head
    %meta{content: "text/html; charset=UTF-8", http: {equiv: "Content-Type"}}
    %title WakatterSample
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload'
    = javascript_pack_tag 'application', 'data-turbolinks-track': 'reload'
  %body
    %header.l-header
      .l-header__site-title
        .l-header__logo
          %h1.c-logo
            = link_to root_path do
              = displayed_svg 'logo.svg', alt: 'Pikawaka'
        %span.l-header__site-author Made by Pikawaka
      .l-header__navigation
        %nav.l-gnav
          %ul.l-gnav__list
            - if user_signed_in?
              %li.l-gnav__link
                = link_to 'マイページ', '#'
              %li.l-gnav__link
                = link_to 'ログアウト', destroy_user_session_path, method: :delete
            - else
              %li.l-gnav__link
                = link_to 'ログイン', new_user_session_path
              %li.l-gnav__button
                = link_to '無料会員登録', new_user_registration_path, class: 'p-button c-button--header'
    = yield
