%header#header.l-header{style: 'margin-top: -10px;'}
  .l-header__site-title
    .l-header__logo
      %h1
        = link_to root_path do
          = displayed_svg 'logo.svg', alt: 'Pikawaka'
    .l-header__author
      %span.l-header__site-author Made by Pikawaka
      %span.l-header__site-author Challenge Lesson
  .l-header__navigation
    %nav.l-gnav
      %input#gnav-input.l-gnav__hum-menu.u-dn{type: 'checkbox'}
      %label.l-gnav__open-menu{for: 'gnav-input'}
        %span
      %label.l-gnav__close-menu{for: 'gnav-input'}
      - if user_signed_in?
        .l-gnav__contents--after-login
          %ul.l-gnav__list
            %li.l-gnav__button
              = link_to 'わかったを投稿する', new_post_path, class: 'p-button c-button--header'
            %li.l-gnav__avatar.dropdown
              %a.l-gnav__user-info.dropdown-toggle{"data-bs-toggle" => "dropdown", "aria-expanded" => "false", "id" => "dropdownUserLink", "href" => "#"}
                = image_pack_tag 'default_icon.png', alt: 'プロフィール画像', class: 'c-image__middle__round'
                %p.l-gnav__user-name= current_user.username
              %ul.l-gnav__user-menu.dropdown-menu{"aria-labelledby" => "dropdownUserLink"}
                %li.l-gnav__user-link
                  = link_to 'マイページ', edit_user_registration_path
                %li.l-gnav__user-link
                  = link_to 'ログアウト', destroy_user_session_path, method: :delete
          %ul
            %li.l-gnav__news.dropdown
              %a.l-gnav__bell.js-activeNews.dropdown-toggle{"data-bs-toggle" => "dropdown", "aria-expanded" => "false", "id" => "dropdownNewsLink", "href" => "#"}
                = icon('fas', 'bell')
                - if current_user.notifications.unread.exists?
                  %span.badge.badge-danger= current_user.notifications.unread.count
              %ul.l-gnav__news-menu.dropdown-menu{"aria-labelledby" => "dropdownNewsLink"}
                %li.l-gnav__news-title お知らせ
                - if current_user.notifications.recent.limit(5).exists?
                  - current_user.notifications.recent.limit(5).each do |notification|
                    %li.l-gnav__news-link{class: notification.read? ? '' : 'unread'}
                      - if notification.post
                        = link_to notification.post.title.truncate(30), post_path(notification.post)
                        = notification.message
                      - else
                        = notification.message
                  %li.l-gnav__news-link
                    = link_to '全ての通知を見る', notifications_path
                - else
                  %li.l-gnav__news-link 新しい通知はありません
      - else
        .l-gnav__contents--before-login
          %ul.l-gnav__list
            %li.l-gnav__link
              = link_to 'ログイン', new_user_session_path
            %li.l-gnav__button
              = link_to '無料会員登録', new_user_registration_path, class: 'c-button--header'
