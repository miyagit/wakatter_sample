.l-main
  .l-main__header
    %h2.l-main__header__title ログイン
  .l-form
    = form_with model: @user, url: session_path(@user), class: 'p-form__input', local: true do |f|
      .p-form__input-field
        = f.label :email
        = f.email_field :email, autofocus: true, autocomplete: "email"
      .p-form__input-field
        = f.label :password
        %br/
        = f.password_field :password, autocomplete: "current-password"
      .p-form__input-submit
        = f.submit "ログインする", class: 'p-button c-button--submit'
