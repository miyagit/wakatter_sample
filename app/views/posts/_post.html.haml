.l-article
  .l-article__header
    .p-button__wakatta{class: "js-like-#{post.id}"}
      = render 'like', post: post
    .l-article__header--left
      .l-article__user-info
        - if post.user.avatar.present?
          = image_tag post.user.avatar_url, alt: 'ユーザー画像', class: 'c-image__middle__round'
        - else
          = image_pack_tag 'default_icon.png', alt: 'プロフィール画像', class: 'c-image__middle__round'
        = link_to post.user.username, '#', class: 'l-article__username'
        .l-article__category-box
          %span.l-article__squarebox= post.category.name
          %time= post.created_at.to_s
    .l-article__header--right
      .c-dropdown.dropdown
        %a.dropdown-toggle{"aria-expanded" => "false", "data-toggle" => "dropdown", :href => "#", :id => "dropdownMenuLink"}
          %span.c-dropdown-dots
          %span.c-dropdown-dots
          %span.c-dropdown-dots
        %ul.dropdown-menu{:aria-labelledby => "dropdownMenuLink"}
          - unless action_name == 'show'
            %li.dropdown-item.c-dropdown-item
              = icon('fas', 'book')
              = link_to '詳細', post_path(post), class: 'details'
          - if user_signed_in? && post.user == current_user
            %li.dropdown-item.c-dropdown-item
              = icon('fas', 'edit')
              = link_to '編集', edit_post_path(post), class: 'edit'
            %li.dropdown-item.c-dropdown-item
              = icon('fas', 'trash')
              = link_to "削除", post_path(post), method: :delete, class: 'delete', data: { confirm: "本当に削除しますか？" }
  .l-article__main
    = link_to "#{post.title}", post_path(post), class: 'l-article__title'
    = link_to "#{post.url}", "#{post.url}", target: :_blank, class: 'l-article__url'
    .l-article__description
      = simple_format(post.description)
    = image_tag post.image.url, alt: post.image.identifier + 'の画像', class: 'c-image__square' if post.image.present?
  .l-article__footer
    %span.l-article__footer-label コメント
    .l-article__footer__comment-area
      .l-article__footer__commentbox
        = render(partial: 'comment', collection: post.post_comments, as: 'comment')
        .c-comment__form
          %span.c-comment__form__label コメントを投稿
          - if user_signed_in?
            = form_with model: [post, post.post_comments.new], local: true, mehotd: :post do |f|
              = f.text_area :body, class: 'js-commentarea_resize'
              = f.submit '投稿する', class: 'p-button c-button--comment-post'
          - else
            .c-comment__box
              %p.c-comment__box__login-announce
                %span コメントを投稿するには
                = link_to 'ログイン', new_user_session_path
                %span が必要です。
              %ul.c-comment__box__signup
                %li.c-comment__box__signup--left
                  %span 登録がまだの方は
                %li.c-comment__box__signup--right
                  = link_to '無料会員登録', new_user_registration_path, class: 'p-button c-button--comment-registration'
