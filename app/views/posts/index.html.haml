%header.l-header
  .l-header__site-title
    .l-header__logo
      %h1.c-logo
        = link_to root_path do
          = displayed_svg 'logo.svg', alt: 'Pikawaka'
    %span.l-header__site-author Made by Pikawaka
  .l-header__navigation
    %nav.l-gnav
      %ul.l-gnav__list
        %li.l-gnav__link
          %a{href: '/'} ログイン
        %li.l-gnav__button
          %a{href: '/', class: 'p-button c-button--header'} 無料会員登録

