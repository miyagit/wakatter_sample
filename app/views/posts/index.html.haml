%section.l-main__search
  = form_tag('/posts/search', method: 'get', class: 'l-main__search__form') do
    = text_field_tag(:q, '', class: 'l-main__search__form-input', placeholder: '気になるワードで投稿を検索')
    = submit_tag('検索', name: nil, class: 'l-main__search__form-submit c-button--search')
.l-main__contents
  %ul.l-main__contents__orderlist
    %li.l-main__contents__orderlist-item
      = link_to '新規投稿順', '#', class: 'active'
    %li.l-main__contents__orderlist-item
      = link_to 'わかったが多い順', '#'
  .l-main__contents__box
    - @posts.each do |post|
      .l-main__contents__box__timeline
        .p-timeline__header
          .p-timeline__header--left
            - if post.user.avatar.present?
              = image_tag post.user.avatar_url, alt: 'ユーザー画像', class: 'c-image__middle__round'
            - else
              = image_pack_tag 'default_icon.png', alt: 'プロフィール画像', class: 'c-image__middle__round'
            = link_to post.user.username, '#'
            %span.squarebox= post.category.name
            %time= post.created_at.to_s
          .p-timeline__header--right
            .c-dropdown.dropdown
              %a.dropdown-toggle{"aria-expanded" => "false", "data-toggle" => "dropdown", :href => "#", :id => "dropdownMenuLink"}
                %span.c-dropdown-dots
                %span.c-dropdown-dots
                %span.c-dropdown-dots
              %ul.dropdown-menu{:aria-labelledby => "dropdownMenuLink"}
                %li.dropdown-item
                  = icon('fas', 'book')
                  = link_to '詳細', post_path(post), class: 'details'
                - if user_signed_in? && post.user == current_user
                  %li.dropdown-item
                    = icon('fas', 'edit')
                    = link_to '編集', edit_post_path(post), class: 'edit'
                  %li.dropdown-item
                    = icon('fas', 'trash')
                    = link_to "削除", post_path(post), method: :delete, class: 'delete', data: { confirm: "本当に削除しますか？" }
        .p-timeline__main
          = link_to "#{post.title}", '#', class: 'p-timeline__main-title'
          = link_to "#{post.url}", "#{post.url}", target: :_blank, class: 'p-timeline__main-url'
          .p-timeline__main-description
            = simple_format(post.description)
          = image_tag post.image.url, alt: post.image.identifier + 'の画像', class: 'c-image__square' if post.image.present?
        .p-timeline__footer
          %span.p-timeline__footer-label コメント
          .p-timeline__footer__comment-area
            .p-timeline__footer__commentbox
              - post.post_comments.each do |comment|
                .p-timeline__footer__commentbox-unit
                  - if comment.user.avatar.present?
                    = image_tag comment.user.avatar_url, alt: 'ユーザー画像', class: 'p-timeline__footer__commentbox-img c-image__small__round'
                  - else
                    = image_pack_tag 'default_icon.png', alt: 'プロフィール画像', class: 'p-timeline__footer__commentbox-img c-image__small__round'
                  = link_to comment.user.username, '#', class: 'p-timeline__footer__commentbox-username'
                  %time.p-timeline__footer__commentbox-time= comment.created_at.to_s
                  .p-timeline__footer__commentbox-description
                    = simple_format(comment.body)
              .c-comment-wrapper
                %span.c-comment-label コメントを投稿
                - if user_signed_in?
                  = form_with model: [post, post.post_comments.new], local: true, mehotd: :post do |f|
                    = f.text_area :body, class: 'js-commentarea_resize'
                    = f.submit '投稿する', class: 'p-button c-button--comment-post'
                - else
                  .c-comment__box
                    %p.c-comment__box-login_announce
                      %span コメントを投稿するには
                      = link_to 'ログイン', '#'
                      %span が必要です。
                    %ul.c-comment__box__list
                      %li.c-comment__box__list-left
                        %span 登録がまだの方は
                      %li.c-comment__box__list-right
                        = link_to '無料会員登録', new_user_registration_path, class: 'p-button c-button--comment-registration'
    .l-main__contents__box__sidebar
  / .p-button__wakatta
  /   %button{title: 'わかった！', type: '', class: 'c-button--wakatta-button'}
  /   %p.c-button--wakatta-button__number 13
  /   %p.c-button--wakatta-button__text わかった！

%script new AutoResizer($('.js-commentarea_resize'));
