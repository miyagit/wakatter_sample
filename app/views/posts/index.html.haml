%section.l-main__search
  = form_tag('/posts/search', method: 'get', class: 'l-main__search__form') do
    = text_field_tag(:q, '', class: 'l-main__search__form-input', placeholder: '気になるワードで投稿を検索')
    = submit_tag('検索', name: nil, class: 'l-main__search__form-submit c-button--search')
.l-main__contents
  %ul.l-main__contents__orderlist
    %li.l-main__contents__orderlist-item
      = link_to '新規投稿順', '#', class: 'active'
    %li.l-main__contents__orderlist-item
      = link_to 'わかったが多い順', '#'
  .l-main__contents__box
    .l-main__contents__box-timeline_wrapper
      = render @posts
    .l-main__contents__box__sidebar.p-sidebar
      %p.p-sidebar-heading 人気投稿順
      .p-sidebar-wrapper
        .p-sidebar__box
          = render partial: 'layouts/sidebar', collection: @sidebar_posts, as: 'post'
%script new AutoResizer($('.js-commentarea_resize'));


