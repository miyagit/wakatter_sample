.l-main__header
  %h2.l-main__header__title= "#{@user.username}さんの詳細ページ"
  .l-main__header__user-info
    - if @user.avatar.present?
      = image_tag @user.avatar_url, alt: 'ユーザー画像', class: 'c-image__middle__round'
    - else
      = image_pack_tag 'default_icon.png', alt: 'プロフィール画像', class: 'c-image__middle__round'
    %p.l-main__header__username= @user.username

.l-main__contents
  %ul.l-main__contents__orderlist
    %li.l-main__contents__orderlist-item
      %a.js-tab-link{href: "#user-posts", class: "active"} 投稿一覧
    %li.l-main__contents__orderlist-item
      %a.js-tab-link{href: "#liked-posts"} いいね一覧
    %li.l-main__contents__orderlist-item
      %a.js-tab-link{href: "#commented-posts"} コメント一覧

  .l-main__contents__box
    .l-article__wrapper
      .js-tab-content#user-posts.active
        %h3 投稿一覧 (#{@user_posts.count}件)
        - if @user_posts.any?
          = render @user_posts
        - else
          %p.l-article__empty まだ投稿がありません。

      .js-tab-content#liked-posts{style: "display: none;"}
        %h3 いいね一覧 (#{@liked_posts.count}件)
        - if @liked_posts.any?
          = render @liked_posts
        - else
          %p.l-article__empty まだいいねがありません。

      .js-tab-content#commented-posts{style: "display: none;"}
        %h3 コメント一覧 (#{@commented_posts.count}件)
        - if @commented_posts.any?
          = render @commented_posts
        - else
          %p.l-article__empty まだコメントがありません。

:javascript
  document.addEventListener('DOMContentLoaded', function() {
    const tabLinks = document.querySelectorAll('.js-tab-link');
    const tabContents = document.querySelectorAll('.js-tab-content');

    tabLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        
        // Remove active class from all links and contents
        tabLinks.forEach(function(l) { l.classList.remove('active'); });
        tabContents.forEach(function(c) { 
          c.classList.remove('active'); 
          c.style.display = 'none';
        });
        
        // Add active class to clicked link
        this.classList.add('active');
        
        // Show corresponding content
        const targetId = this.getAttribute('href').substring(1);
        const targetContent = document.getElementById(targetId);
        if (targetContent) {
          targetContent.classList.add('active');
          targetContent.style.display = 'block';
        }
      });
    });
  });